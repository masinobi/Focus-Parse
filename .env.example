# Optional. Enables the "Check my recall" button in the cognitive intercept,
# which grades your summary against the section text.
#
# Set ONE of these. Gemini takes precedence if both are present.
# Copy this file to .env.local and restart the dev server.

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override; defaults to gemini-3.6-flash
# GEMINI_MODEL=

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
