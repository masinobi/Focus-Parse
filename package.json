{
  "name": "focusparse",
  "version": "0.1.0",
  "private": true,
  "description": "A reading tool that paces a document with speech synthesis, locks a word-level highlight to the audio, and refuses to let you coast past a section boundary without restating what you just heard.",
  "keywords": [
    "reading",
    "accessibility",
    "adhd",
    "text-to-speech",
    "web-speech-api",
    "active-recall",
    "spaced-repetition",
    "pdf",
    "nextjs"
  ],
  "homepage": "https://github.com/masinobi/Focus-Parse#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masinobi/Focus-Parse.git"
  },
  "bugs": {
    "url": "https://github.com/masinobi/Focus-Parse/issues"
  },
  "license": "MIT",
  "author": "Michelle Asinobi",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "study": "next build && next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "test": "vitest run",
    "probe": "node scripts/probe-ui.mjs",
    "scan-blueprint": "node scripts/scan-blueprint.mjs",
    "scan-checks": "node scripts/scan-checks.mjs",
    "scan-citations": "node scripts/scan-citations.mjs",
    "scan-columns": "node scripts/scan-columns.mjs",
    "scan-compare": "node scripts/scan-compare.mjs",
    "scan-coverage": "node scripts/scan-coverage.mjs",
    "scan-entities": "node scripts/scan-entities.mjs",
    "scan-exam": "node scripts/scan-exam.mjs",
    "scan-headings": "node scripts/scan-headings.mjs",
    "scan-perf": "node scripts/scan-perf.mjs",
    "scan-sql": "node scripts/scan-sql.mjs",
    "scan-tables": "node scripts/scan-tables.mjs",
    "scan-tiers": "node scripts/scan-tiers.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@google/genai": "^2.18.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "next": "14.2.18",
    "pdfjs-dist": "^4.8.69",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.1.6",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.18",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}
